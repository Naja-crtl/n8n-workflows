# Copy to .env on the server and fill in. Never commit .env.

# Public hostname. Without your own domain, use the VM's public IP with dashes + .sslip.io
# Example for IP 203.0.113.10 -> 203-0-113-10.sslip.io
N8N_HOST=

# Supabase Session pooler (Connect > Session pooler, port 5432)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.YOUR_PROJECT_REF
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# Generate with: openssl rand -hex 32   (back it up in your password manager)
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Asia/Dubai
TZ=Asia/Dubai
N8N_DIAGNOSTICS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
