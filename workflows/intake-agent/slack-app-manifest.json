{
  "display_information": {
    "name": "Intake Agent",
    "description": "Intake approvals and /ask questions for NB-Systems",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "Intake Agent",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/ask",
        "url": "https://YOUR_N8N_HOST/webhook/leads-ask",
        "description": "Ask about leads, posts, demos, workflows and intakes",
        "usage_hint": "which demo was down this week?",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "files:write",
        "commands"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "is_hosted": false,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR_N8N_HOST/webhook/intake-slack"
    }
  }
}
